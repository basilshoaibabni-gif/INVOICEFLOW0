# ─────────────────────────────────────────────────────────────
# InvoiceFlow — environment template
# Copy to `.env.local` and fill in. Everything prefixed VITE_ is
# bundled into the browser, so ONLY public keys go here.
# Safepay SECRET key + webhook secret live in n8n credentials, never here.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://dkoxduuyxmqavlgqapfy.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_plSMGPOUv1M-6QaYjdv-bw_Xt-2Hdj3

# Public site URL (used for auth redirects + client portal links)
VITE_APP_URL=http://localhost:5173

# Safepay (public/client key only)
VITE_SAFEPAY_ENV=sandbox            # sandbox | production
VITE_SAFEPAY_PUBLIC_KEY=sec_xxxxxxxxxxxxxxxxxxxxxxxx

# n8n Cloud webhook base, e.g. https://yourname.app.n8n.cloud/webhook
VITE_N8N_WEBHOOK_BASE=https://your-instance.app.n8n.cloud/webhook

# Pro plan pricing shown in the UI
VITE_PRO_PRICE_USD=15
VITE_PRO_PRICE_PKR=4200
